{
  "name": "get_icon",
  "description": "Get SVG data and raw vector markup for a specific icon ID (e.g. 'lucide:home').",
  "parameters": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Icon ID in format prefix:name (e.g. 'lucide:bar-chart-3')"
      },
      "color": {
        "type": "string",
        "description": "Hex color or currentColor"
      },
      "size": {
        "type": "integer",
        "description": "Size in pixels (default 24)"
      }
    },
    "required": [
      "id"
    ]
  }
}